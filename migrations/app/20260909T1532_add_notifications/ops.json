        ]
      }
    ],
    "execute": [
      {
        "description": "create table \"notification\"",
        "sql": "CREATE TABLE \"public\".\"notification\" (\n  \"channel\" text NOT NULL,\n  \"createdAt\" timestamptz DEFAULT (now()) NOT NULL,\n  \"dedupeKey\" text,\n  \"entryId\" text,\n  \"eventId\" text,\n  \"id\" text NOT NULL,\n  \"message\" text NOT NULL,\n  \"queueId\" text,\n  \"readAt\" timestamptz,\n  \"title\" text NOT NULL,\n  \"type\" text NOT NULL,\n  \"userId\" text NOT NULL,\n  PRIMARY KEY (\"id\"),\n  CONSTRAINT \"notification_channel_check_7b5c13c0\" CHECK (\"channel\" IN ('IN_APP', 'EMAIL', 'SMS', 'PUSH')),\n  CONSTRAINT \"notification_type_check_2df23cfa\" CHECK (\"type\" IN ('QUEUE_JOINED', 'TURN_APPROACHING', 'PATIENT_CALLED', 'CONSULTATION_STARTED', 'QUEUE_COMPLETED', 'QUEUE_CANCELLED', 'QUEUE_PAUSED', 'QUEUE_RESUMED', 'NO_SHOW'))\n)",
        "params": []
      }
    ],
    "postcheck": [
      {
        "description": "verify table \"notification\" exists",
        "sql": "SELECT (to_regclass($1)) IS NOT NULL AS \"result\"",
        "params": [
          "\"public\".\"notification\""
        ]
      }
    ]
  },
